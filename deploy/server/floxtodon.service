[Unit]
Description=floxtodon.dev — Mastodon (all processes run as Flox services)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mastodon
Group=mastodon
WorkingDirectory=/home/mastodon/live
# One activation starts postgres, redis, web, sidekiq, streaming and caddy;
# they stop when this activation ends.
ExecStart=/usr/bin/flox activate -d /home/mastodon/live/deploy/server --start-services -- sleep infinity
Restart=always
RestartSec=10
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
